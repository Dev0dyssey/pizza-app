# Firebase Console → Project settings → General → Your apps → Web app → Config.
# The Firebase web config identifies the app; it is not a private service-account key.
VITE_FIREBASE_API_KEY=replace-with-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id
VITE_FIREBASE_MEASUREMENT_ID=replace-with-measurement-id

# Local development only. Set to true to bypass Firebase and use sample data.
VITE_DEMO_MODE=false
