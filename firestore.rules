rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath(groupId, userId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(userId);
    }

    function isGroupMember(groupId) {
      return isSignedIn() && exists(membershipPath(groupId, request.auth.uid));
    }

    match /groups/{groupId} {
      allow get: if isGroupMember(groupId);
      allow list: if false;

      // The client must atomically create its matching owner membership.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(membershipPath(groupId, request.auth.uid))
        && getAfter(membershipPath(groupId, request.auth.uid)).data.role == 'owner';

      allow update, delete: if false;

      match /members/{userId} {
        // Membership discovery can only return the signed-in user's documents.
        allow get: if isSignedIn() && userId == request.auth.uid;
        allow list: if isSignedIn()
          && resource.data.userId == request.auth.uid;

        // A user can create only their own owner membership, paired with a
        // newly-created group that names them as owner.
        allow create: if isSignedIn()
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'displayName', 'role', 'joinedAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 256
          && request.resource.data.role == 'owner'
          && request.resource.data.joinedAt == request.time
          && existsAfter(/databases/$(database)/documents/groups/$(groupId))
          && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;

        // One-time migration for memberships created before userId was stored.
        allow update: if isSignedIn()
          && userId == request.auth.uid
          && !resource.data.keys().hasAny(['userId'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId'])
          && request.resource.data.userId == request.auth.uid;

        allow delete: if false;
      }
    }

    // Collection-group queries must be explicitly allowed in Rules v2.
    match /{path=**}/members/{userId} {
      allow get: if isSignedIn() && userId == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
